# ─────────────────────────────────────────────────────────────────────────────
# infra/docker/.env.example — Docker Compose Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to infra/docker/.env and fill in real values.
# NEVER commit the .env file to Git.
#
#   cp infra/docker/.env.example infra/docker/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=7860
FLASK_DEBUG=false

# ── Application Secrets ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars

# ── MinIO (Self-Hosted S3-Compatible Object Storage) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production_use_strong_password
MINIO_BUCKET=cardiosense-uploads

# ── Cloudflare R2 (Production Object Storage — Cloud) ────────────────────────
# Used when deploying to Hugging Face Spaces (Model 1).
# Leave blank if using local MinIO (Model 2).
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=cardiosense-models
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── Monitoring (Optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
